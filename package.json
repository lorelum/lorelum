{
  "name": "lorelum",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "build:cli": "bun scripts/compile-cli.ts",
    "verify:compiled-cli": "bun scripts/verify-compiled-cli.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "5.7.2"
  },
  "overrides": {
    "js-yaml": "3.15.0"
  },
  "packageManager": "bun@1.3.8"
}
